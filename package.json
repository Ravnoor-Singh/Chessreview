{
  "dependencies": {
    "chess.js": "1.4.0",
    "framer-motion": "14.8.0",
    "idb": "8.0.4",
    "lz-string": "1.5.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stockfish": "19.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "description": "Chess.com-style game review powered by Stockfish WASM in the browser",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@next/bundle-analyzer": "16.4.3",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "GPL-3.0-or-later",
  "name": "chess-review",
  "private": true,
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "build": "node scripts/build-sw.mjs && next build && node scripts/check-bundle.mjs",
    "build:noiso": "node scripts/build-sw.mjs && NOISO=1 next build",
    "build:sw": "node scripts/build-sw.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev": "next dev",
    "engine:report": "node scripts/engine-report.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "node scripts/copy-engine.mjs",
    "start": "next start",
    "start:noiso": "NOISO=1 next start",
    "test": "vitest run",
    "test:e2e": "npm run build:noiso && E2E_NOISO=1 playwright test",
    "test:e2e:light": "playwright test --project=chromium",
    "test:e2e:heavy": "npm run build:noiso && E2E_NOISO=1 playwright test --project=heavy --project=chromium-noiso",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures:vision": "node scripts/make-vision-fixtures.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:coverage && npm run test:e2e:light",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lhci": "lhci autorun",
    "test:profiles": "node scripts/test-profiles.mjs",
    "engine:upload": "node scripts/upload-engine.mjs",
    "build:cdn": "node scripts/build-sw.mjs && CDN=1 NEXT_PUBLIC_ENGINE_BASE_URL=http://127.0.0.1:3202/engine next build",
    "start:cdn": "CDN=1 next start",
    "test:e2e:cdn": "npm run build:cdn && E2E_CDN=1 playwright test --project=chromium-cdn",
    "build:lite": "ENGINE_BUNDLE=lite-only node scripts/copy-engine.mjs && node scripts/build-sw.mjs && LITE=1 next build",
    "start:lite": "LITE=1 next start",
    "test:e2e:lite": "sh -c 'npm run build:lite && E2E_LITE=1 playwright test --project=chromium-lite; code=$?; node scripts/copy-engine.mjs; npm run build:sw >/dev/null; exit $code'",
    "vision:eval": "node scripts/vision-eval.mjs",
    "check:unused": "node scripts/check-unused.mjs",
    "glossary:check": "node scripts/check-glossary.mjs",
    "themes:check": "node scripts/themes-check.mjs && node scripts/make-piece-sets.mjs --check",
    "i18n:export-review": "node scripts/export-i18n-review.mjs",
    "i18n:import-review": "node scripts/import-i18n-review.mjs"
  },
  "version": "1.0.0"
}
