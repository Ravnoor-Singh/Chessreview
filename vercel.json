{
  "headers": [
    {
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' https://lichess.org https://api.chess.com; media-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }],
      "source": "/engine/(.*)"
    },
    {
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }],
      "source": "/engine/engine-manifest.json"
    },
    {
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }],
      "source": "/sw.js"
    },
    {
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }],
      "source": "/pieces/(.*)"
    },
    {
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }],
      "source": "/openings/(.*)"
    }
  ]
}
